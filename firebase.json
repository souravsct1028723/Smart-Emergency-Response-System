{
  "firestore": {
    "rules": "firestore.rules"
  },

  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "guardian-alert-sers",
          "appId": "1:551518726776:android:f669357332c8d9dbd15b8d",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "guardian-alert-sers",
          "configurations": {
            "android": "1:551518726776:android:f669357332c8d9dbd15b8d"
          }
        }
      }
    }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "venv",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "runtime": "python311"
    }
  ],

  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8085
    },
    "functions": {
      "port": 5001
    },
    "ui": {
      "enabled": true,
      "port": 4000
    }
  }
